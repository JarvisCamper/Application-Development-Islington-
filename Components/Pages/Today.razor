@page "/today"
@using MudBlazor

<MudPaper Class="pa-6" Elevation="2" MaxWidth="700px">

    <MudText Typo="Typo.h5" GutterBottom="true">
        Today’s Journal Entry
    </MudText>

    <MudText Typo="Typo.body2" Class="mb-3">
        Write your thoughts and reflections for today.
    </MudText>

    <MudTextField @bind-Value="entryText"
                  Label="Journal Entry"
                  Variant="Variant.Outlined"
                  Lines="8"
                  FullWidth="true" />

    <MudButton Class="mt-4"
               Color="Color.Primary"
               Variant="Variant.Filled"
               OnClick="SaveEntry">
        Save Entry
    </MudButton>

</MudPaper>

@code {
    private string entryText = string.Empty;

    private void SaveEntry()
    {
        // Later we will save this to a database or file
        Console.WriteLine(entryText);
    }
}
