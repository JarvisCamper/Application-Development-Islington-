@page "/"
@using MudBlazor

<MudText Typo="Typo.h4" GutterBottom="true">
    Welcome to My Journal
</MudText>

<MudPaper Elevation="1" Class="pa-4 mt-4">

    <MudText Typo="Typo.body1">
        This application allows you to write daily journal entries,
        reflect on your thoughts, and track your emotions over time.
    </MudText>

    <MudDivider Class="my-4" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.EditNote"
               Href="/today">
        Write Today’s Entry
    </MudButton>

</MudPaper>
