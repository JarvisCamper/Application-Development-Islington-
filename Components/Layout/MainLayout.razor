@inherits LayoutComponentBase
@using MudBlazor
@using JournalApp.Components.Layout

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6">Journal App</MudText>
    </MudAppBar>


    <MudDrawer Open="true"
               Variant="DrawerVariant.Persistent"
               Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-6 mt-4">
        @Body
    </MudMainContent>

</MudLayout>
