@inherits LayoutComponentBase
@using MudBlazor
@using JournalApp.Components.Layout

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />  

<MudLayout>

    <!-- Top App Bar -->
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6">Journal App</MudText>
    </MudAppBar>

    <!-- Side Navigation Drawer -->
    <MudDrawer Open="true"
               Variant="DrawerVariant.Persistent"
               Elevation="1">
        <NavMenu />
    </MudDrawer>

    <!-- Main Content -->
    <MudMainContent Class="pa-6 mt-16">
        @Body
    </MudMainContent>

</MudLayout>
