<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData"
                   DefaultLayout="@typeof(JournalApp.Components.Layout.MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(JournalApp.Components.Layout.MainLayout)">
            <MudText>Page not found</MudText>
        </LayoutView>
    </NotFound>
</Router>
