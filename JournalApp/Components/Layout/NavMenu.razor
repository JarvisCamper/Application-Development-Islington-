@using Microsoft.AspNetCore.Components.Routing

<!-- Sidebar Brand Header -->
<div class="sidebar-brand">
    <h1 class="brand-title">
        <span class="brand-icon">📓</span>
        My Journal
    </h1>
</div>

<!-- Navigation -->
<div class="sidebar-nav">
    <nav class="flex-column">
        <div class="nav-item-journal">
            <NavLink class="nav-link-journal" href="" Match="NavLinkMatch.All">
                <span class="nav-icon oi oi-book"></span>
                <span>Dashboard</span>
            </NavLink>
        </div>
        <div class="nav-item-journal">
            <NavLink class="nav-link-journal" href="journal/add">
                <span class="nav-icon oi oi-pencil"></span>
                <span>Write your story</span>
            </NavLink>
        </div>
        <div class="nav-item-journal">
            <NavLink class="nav-link-journal" href="calendar">
                <span class="nav-icon oi oi-calendar"></span>
                <span>Calendar</span>
            </NavLink>
        </div>
        <div class="nav-item-journal">
            <NavLink class="nav-link-journal" href="search">
                <span class="nav-icon oi oi-magnifying-glass"></span>
                <span>Search</span>
            </NavLink>
        </div>
        <div class="nav-item-journal">
            <NavLink class="nav-link-journal" href="analytics">
                <span class="nav-icon oi oi-graph"></span>
                <span>Analytics</span>
            </NavLink>
        </div>
        <div class="nav-item-journal">
            <NavLink class="nav-link-journal" href="export">
                <span class="nav-icon oi oi-data-transfer-download"></span>
                <span>Export</span>
            </NavLink>
        </div>
        <div class="nav-item-journal">
            <NavLink class="nav-link-journal" href="settings">
                <span class="nav-icon oi oi-cog"></span>
                <span>Settings</span>
            </NavLink>
        </div>
    </nav>
</div>

<!-- Sidebar Footer -->
<div class="sidebar-footer">
    <button class="btn btn-link text-muted text-decoration-none w-100 d-flex align-items-center justify-content-center gap-2" @onclick="Logout">
        <span>🚪</span> Close Journal
    </button>
</div>

@using JournalApp.Services
@inject ISecurityService SecurityService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@code {
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    private async Task Logout()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Close your journal for now?");
        if (confirmed)
        {
            SecurityService.Logout();
            NavigationManager.NavigateTo("/login");
        }
    }
}
