@page "/export"
@using JournalApp.Models.Common
@using JournalApp.Services
@using JournalApp.Components.Common
@using System.IO
@inject IExportService ExportService
@inject IJSRuntime JS

<div class="container p-4">
    <div class="paper-card">
        <h2 class="text-serif text-gradient mb-4">Export Journal</h2>
        <p class="text-muted mb-4">Select a date range to export your journal entries as a PDF.</p>

        <div class="row">
            <div class="col-md-5 mb-3">
                <label class="label-journal">Start Date</label>
                <input type="date" class="input-journal" @bind="startDate" />
            </div>
            <div class="col-md-5 mb-3">
                <label class="label-journal">End Date</label>
                <input type="date" class="input-journal" @bind="endDate" />
            </div>
            <div class="col-md-2 mb-3 d-flex align-items-end">
                <button class="btn-primary-journal w-100" @onclick="ExportPdf" disabled="@isExporting">
                    @if (isExporting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span class="ms-1">Generating...</span>
                    }
                    else
                    {
                        <span class="oi oi-data-transfer-download me-2" aria-hidden="true"></span>
                        <span>Export</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Toast? Toast { get; set; }
    
    private DateTime? startDate = DateTime.Today.AddMonths(-1);
    private DateTime? endDate = DateTime.Today;
    private bool isExporting = false;

    private async Task ExportPdf()
    {
        if (startDate > endDate)
        {
            Toast?.ShowWarning("Start date must be before end date.", "Invalid Date Range");
            return;
        }
        
        try
        {
            isExporting = true;
            var range = new DateRangeDto { StartDate = startDate, EndDate = endDate };
            var pdfBytes = await ExportService.ExportToPdfAsync(range);

            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(pdfBytes));
            var fileName = $"Journal_Export_{DateTime.Now:yyyyMMdd}.pdf";
            
            await JS.InvokeVoidAsync("appFunctions.downloadFileFromStream", fileName, streamRef);
            Toast?.ShowSuccess("Your journal export is ready!", "Export Complete");
        }
        catch (Exception ex)
        {
            Toast?.ShowError("We couldn't export your journal. Please try again.", "Export Failed");
            Console.WriteLine($"Export error: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }
}
