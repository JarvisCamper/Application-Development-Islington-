@page "/setup-password"
@using JournalApp.Components.Layout
@using JournalApp.Components.Common
@layout EmptyLayout
@inject ISecurityService SecurityService
@inject NavigationManager NavigationManager

<div class="d-flex justify-content-center align-items-center min-vh-100 p-4" style="background: var(--paper-bg);">
    <div class="paper-card p-4 p-md-5" style="max-width: 500px; width: 100%;">
        <div class="text-center mb-4">
            <div class="mb-3" style="font-size: 3rem;">🌟</div>
            <h2 class="text-serif text-gradient mb-1">Create Your Journal</h2>
            <p class="text-muted">Let's set up your profile and security.</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger border-0 mb-4" style="background: rgba(239, 68, 68, 0.1); color: #dc3545;">
                ⚠️ @errorMessage
            </div>
        }

        <!-- Profile Section -->
        <div class="mb-4">
            <label for="displayName" class="label-journal">Your Name</label>
            <input type="text" class="input-journal @(showValidation && string.IsNullOrWhiteSpace(displayName) ? "is-invalid-journal" : "")" id="displayName" @bind="displayName" placeholder="How should we call you?" />
        </div>

        <!-- Password Section -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label for="password" class="label-journal">New Password</label>
                <input type="password" class="input-journal @(showValidation && string.IsNullOrWhiteSpace(password) ? "is-invalid-journal" : "")" id="password" @bind="password" placeholder="Min 4 chars" />
            </div>
            <div class="col-md-6">
                 <label for="confirmPassword" class="label-journal">Confirm</label>
                <input type="password" class="input-journal @(showValidation && string.IsNullOrWhiteSpace(confirmPassword) ? "is-invalid-journal" : "")" id="confirmPassword" @bind="confirmPassword" placeholder="Repeat" />
            </div>
        </div>

        <!-- Security Questions -->
        <div class="mb-4 p-3 rounded" style="background: var(--nav-bg-hover); border: 1px solid var(--sidebar-border);">
            <p class="text-muted small mb-3">
                <strong>🔐 Security Questions</strong> (For recovery)<br/>
                <span style="font-size: 0.8rem; opacity: 0.8;">Please answer these questions to secure your account.</span>
            </p>
            
            <div class="mb-2">
                <label class="label-journal" style="font-size: 0.8rem;">What is your favorite color?</label>
                <input type="text" class="input-journal py-2 @(showValidation && string.IsNullOrWhiteSpace(answer1) ? "is-invalid-journal" : "")" style="font-size: 0.9rem;" @bind="answer1" />
            </div>
            
            <div class="mb-2">
                <label class="label-journal" style="font-size: 0.8rem;">What is your pet's name?</label>
                <input type="text" class="input-journal py-2 @(showValidation && string.IsNullOrWhiteSpace(answer2) ? "is-invalid-journal" : "")" style="font-size: 0.9rem;" @bind="answer2" />
            </div>
            
            <div class="mb-0">
                <label class="label-journal" style="font-size: 0.8rem;">What city were you born in?</label>
                <input type="text" class="input-journal py-2 @(showValidation && string.IsNullOrWhiteSpace(answer3) ? "is-invalid-journal" : "")" style="font-size: 0.9rem;" @bind="answer3" @onkeyup="HandleKeyUp" />
            </div>
        </div>

        <button class="btn-primary-journal w-100 py-3" @onclick="SetPassword">
            🚀 Create My Journal
        </button>
    </div>
</div>

<style>
    .is-invalid-journal {
        border-color: #dc3545 !important;
        background-color: rgba(220, 53, 69, 0.05) !important;
    }
</style>

@code {
    private string displayName = "";
    private string password = "";
    private string confirmPassword = "";
    private string answer1 = "";
    private string answer2 = "";
    private string answer3 = "";
    private string errorMessage = "";
    private bool showValidation = false;

    protected override async Task OnInitializedAsync()
    {
        if (await SecurityService.IsPasswordSetAsync())
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    private async Task SetPassword()
    {
        errorMessage = "";
        showValidation = true;

        if (string.IsNullOrWhiteSpace(displayName))
        {
            errorMessage = "Please enter your name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Password cannot be empty.";
            return;
        }

        if (password.Length < 4)
        {
            errorMessage = "Password must be at least 4 characters.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (string.IsNullOrWhiteSpace(answer1) || string.IsNullOrWhiteSpace(answer2) || string.IsNullOrWhiteSpace(answer3))
        {
            errorMessage = "Please answer all security questions.";
            return;
        }

        try
        {
            await SecurityService.SetupPasswordAsync(password, displayName, answer1, answer2, answer3);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SetPassword();
        }
    }
}
