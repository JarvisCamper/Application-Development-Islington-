@page "/login"
@using JournalApp.Components.Layout
@layout EmptyLayout
@inject ISecurityService SecurityService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="d-flex justify-content-center align-items-center vh-100 animate-fade-in-up" style="background: var(--paper-bg);">
    <div class="paper-card p-5" style="max-width: 400px; width: 100%;">
        <div class="text-center mb-5">
            <div class="mb-3" style="font-size: 3rem;">📓</div>
            <h1 class="text-serif text-gradient mb-1">My Journal</h1>
            <p class="text-muted">Welcome back! Please sign in.</p>
        </div>
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger border-0 mb-4" style="background: rgba(239, 68, 68, 0.1); color: #dc3545;">
                <span style="font-weight: 500;">⚠️ @errorMessage</span>
            </div>
        }

        <div class="mb-4">
            <label for="password" class="label-journal">Password / PIN</label>
            <input type="password" class="input-journal" id="password" @bind="password" @onkeyup="HandleKeyUp" placeholder="Enter your password" />
        </div>

        <div class="mb-4 d-flex align-items-center gap-2">
            <input type="checkbox" 
                   class="form-check-input" 
                   id="rememberMe" 
                   @bind="rememberMe"
                   style="width: 1.25rem; height: 1.25rem; margin: 0; cursor: pointer; accent-color: var(--accent-gold);" />
            <label class="form-check-label" for="rememberMe" style="color: var(--ink-secondary); cursor: pointer; user-select: none;">
                Remember me for 30 days
            </label>
        </div>

        <button class="btn-primary-journal w-100 py-3" @onclick="AttemptLogin">
            <span style="font-size: 1.1rem;">🔓 Sign In</span>
        </button>
        
        <div class="text-center mt-3">
            <a href="/forgot-password" style="color: var(--accent-gold); text-decoration: none; font-weight: 500;">
                Forgot Password?
            </a>
        </div>
    </div>
</div>

@code {
    private string password = "";
    private string errorMessage = "";
    private bool rememberMe = false;

    protected override async Task OnInitializedAsync()
    {
        await SecurityService.InitializeAsync();
        if (SecurityService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        if (!await SecurityService.IsPasswordSetAsync())
        {
            NavigationManager.NavigateTo("/setup-password");
        }
    }

    private async Task AttemptLogin()
    {
        errorMessage = "";
        await JS.InvokeVoidAsync("appFunctions.hideKeyboard");
        
        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter your password.";
            return;
        }
        
        if (await SecurityService.VerifyPasswordAsync(password))
        {
            await SecurityService.LoginAsync(rememberMe);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            errorMessage = "Invalid password. Please try again.";
            password = "";
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AttemptLogin();
        }
    }
}
