@page "/forgot-password"
@using JournalApp.Components.Layout
@using JournalApp.Components.Common
@layout EmptyLayout
@inject ISecurityService SecurityService
@inject NavigationManager NavigationManager

<div class="d-flex justify-content-center align-items-center min-vh-100 p-4" style="background: var(--paper-bg);">
    <div class="paper-card p-4 p-md-5" style="max-width: 480px; width: 100%;">
        
        @if (!isVerified)
        {
            <!-- Security Questions Step -->
            <div class="text-center mb-4">
                <div class="mb-3" style="font-size: 2.5rem;">🔐</div>
                <h2 class="text-serif text-gradient mb-1">Forgot Password</h2>
                <p class="text-muted">Answer your security questions to reset.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger border-0 mb-4" style="background: rgba(239, 68, 68, 0.1); color: #dc3545;">
                    ⚠️ @errorMessage
                </div>
            }

            <div class="mb-3">
                <label class="label-journal">@question1</label>
                <input type="text" class="input-journal" @bind="answer1" placeholder="Your answer" />
            </div>
            
            <div class="mb-3">
                <label class="label-journal">@question2</label>
                <input type="text" class="input-journal" @bind="answer2" placeholder="Your answer" />
            </div>
            
            <div class="mb-4">
                <label class="label-journal">@question3</label>
                <input type="text" class="input-journal" @bind="answer3" placeholder="Your answer" />
            </div>

            <button class="btn-primary-journal w-100 py-3 mb-3" @onclick="VerifyAnswers">
                ✓ Verify Answers
            </button>
            
            <div class="text-center">
                <a href="/login" class="text-muted" style="text-decoration: none;">← Back to Login</a>
            </div>
        }
        else
        {
            <!-- Reset Password Step -->
            <div class="text-center mb-4">
                <div class="mb-3" style="font-size: 2.5rem;">✅</div>
                <h2 class="text-serif text-gradient mb-1">Reset Password</h2>
                <p class="text-muted">Enter your new password below.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger border-0 mb-4" style="background: rgba(239, 68, 68, 0.1); color: #dc3545;">
                    ⚠️ @errorMessage
                </div>
            }

            <div class="mb-3">
                <label for="newPassword" class="label-journal">New Password</label>
                <input type="password" class="input-journal" id="newPassword" @bind="newPassword" placeholder="Enter new password" />
            </div>

            <div class="mb-4">
                <label for="confirmPassword" class="label-journal">Confirm Password</label>
                <input type="password" class="input-journal" id="confirmPassword" @bind="confirmPassword" placeholder="Confirm new password" />
            </div>

            <button class="btn-primary-journal w-100 py-3" @onclick="ResetPassword">
                🔓 Reset Password
            </button>
        }
    </div>
</div>

@code {
    private string question1 = "";
    private string question2 = "";
    private string question3 = "";
    private string answer1 = "";
    private string answer2 = "";
    private string answer3 = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string errorMessage = "";
    private bool isVerified = false;

    protected override async Task OnInitializedAsync()
    {
        var questions = await SecurityService.GetSecurityQuestionsAsync();
        question1 = questions.Q1;
        question2 = questions.Q2;
        question3 = questions.Q3;
        
        if (string.IsNullOrEmpty(question1))
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    private async Task VerifyAnswers()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(answer1) || string.IsNullOrWhiteSpace(answer2) || string.IsNullOrWhiteSpace(answer3))
        {
            errorMessage = "Please answer all security questions.";
            return;
        }

        if (await SecurityService.VerifySecurityAnswersAsync(answer1, answer2, answer3))
        {
            isVerified = true;
        }
        else
        {
            errorMessage = "Incorrect answers. Please try again.";
        }
    }

    private async Task ResetPassword()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Password cannot be empty.";
            return;
        }

        if (newPassword.Length < 4)
        {
            errorMessage = "Password must be at least 4 characters.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        try
        {
            await SecurityService.ResetPasswordAsync(newPassword);
            await SecurityService.LoginAsync(true);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
